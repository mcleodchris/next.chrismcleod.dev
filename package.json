{
  "name": "chrismcleod.dev",
  "version": "26.10.1",
  "description": "Personal website of Chris McLeod.",
  "author": "Chris McLeod",
  "license": "ISC",
  "main": ".eleventy.js",
  "engines": {
    "node": ">=22.17"
  },
  "type": "module",
  "scripts": {
    "start": "npm run dev:11ty",
    "og": "node helpers/generate-og-images.js",
    "og:force": "node helpers/generate-og-images.js --force",
    "new:note": "node helpers/newNote.js",
    "new:post": "node helpers/newPost.js",
    "new:bookmark": "node helpers/newBookmark.js",
    "new:like": "node helpers/newLike.js",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:11ty && npm run build:index",
    "dev:11ty": "eleventy --serve --watch --port=3000",
    "build:11ty": "eleventy",
    "build:index": "pagefind --site dist",
    "index:serve": "pagefind --site dist --serve",
    "start-quick": "eleventy --serve --incremental --ignore-initial",
    "start-prod": "npm run build && npm run start-quick",
    "check": "node helpers/check-build.js dist",
    "data:sync": "node helpers/sync-data.js",
    "images:sync": "node helpers/sync-images.js",
    "test": "node --test"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/mcleodchris/next.chrismcleod.dev.git"
  },
  "devDependencies": {
    "@11ty/eleventy": "4.0.0-alpha.10",
    "@11ty/eleventy-img": "7.0.0",
    "@11ty/eleventy-plugin-inclusive-language": "1.0.3",
    "@11ty/eleventy-plugin-rss": "2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
    "@toycode/markdown-it-class": "1.2.4",
    "autoprefixer": "10.4.23",
    "cssnano": "7.1.2",
    "esbuild": "0.27.2",
    "fast-xml-parser": "5.11.2",
    "js-yaml": "5.4.3",
    "markdown-it": "14.3.2",
    "markdown-it-abbr": "2.0.0",
    "markdown-it-anchor": "9.2.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-github-alerts": "1.0.0",
    "markdown-it-image-figures": "2.1.1",
    "markdown-it-link-attributes": "4.0.1",
    "markdown-it-mark": "4.0.0",
    "markdown-it-prism": "3.0.1",
    "pagefind": "1.5.2",
    "postcss": "8.5.29",
    "postcss-import": "16.1.1",
    "prettier": "3.7.4",
    "sequoia-cli": "0.5.7",
    "sharp": "0.35.5",
    "slugify": "1.6.6",
    "turndown": "7.2.2"
  },
  "dependencies": {
    "@zachleat/pagefind-search": "1.0.3",
    "cheerio": "1.1.2",
    "html-entities": "2.6.0"
  }
}
