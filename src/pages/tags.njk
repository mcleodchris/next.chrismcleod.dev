---
layout: base
pagination:
  data: collections.contentTags
  size: 1
  alias: tag
permalink: /tags/{{ tag }}/
eleventyComputed:
  title: '{{ tag }}'
---

<header class="section spot-color-light">
    <div class="wrapper flow">
      <section class="prose text-center">
        <h1 class="fade-in">
          Posts Tagged: "{{ title }}"
        </h1>
      </section>
  </div>
</header>

<article class="wrapper region flow prose">
  <ul class="grid mt-l-xl h-feed flow prose" role="list">
    {% set taglist = collections[tag] | reverse %} {% for item in taglist %}
    {% set itemClass = 'flow overflow-hidden' %}{% include "partials/post-list-item.njk" %}
    {% endfor %}
  </ul>
</article>