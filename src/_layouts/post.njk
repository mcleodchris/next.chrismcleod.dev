---
layout: base
---

<article class="region blog h-entry" data-pagefind-body>
  <div class="wrapper flow prose">
    {% include "partials/old-post-warning.njk" %}
    <h1 class="p-name{% if gradient === true %} | gradient-text{% endif %}" >{{ title }}</h1>
    {% set definedDate = date %}
    <div class="post-meta"><a href="{{url | url}}" class="u-url">🔗</a> {% include "partials/date.njk" -%} | by <a class="p-author h-card" href="{{ meta.authorWebsite }}">{{ meta.author }}</a></div>
    <div class="e-content | flow prose">
      {{ content | safe }}
    </div>
    <div class="flow prose">
      <sequoia-recommend></sequoia-recommend>
    </div>
    {% include "partials/post-footer.njk" %}
    <!-- brid.gy -->
    <ul hidden>
      <li><a href="https://brid.gy/publish/mastodon"></a></li>
    </ul>
  </div>
</article>
<section class="region">
  <div class="wrapper flow prose">
    <sequoia-comments></sequoia-comments>
  </div>
</section>
