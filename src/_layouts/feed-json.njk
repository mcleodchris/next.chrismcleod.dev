{
    "version": "https://jsonfeed.org/version/1.1",
    "user_comment": "This is a JSON feed. Subscribe by copying the URL from the address bar into your newsreader.",
    "title": {{ (meta.blog.name + " — " + name + " — JSON Feed") | default("", true) | dump | safe }},
    "description": {{ meta.siteDescription | default("", true) | dump | safe }},
    "home_page_url": {{ meta.url | default("", true) | dump | safe }},
    "feed_url": {{ permalink | absoluteUrl(meta.url) | default("", true) | dump | safe }},
    "authors": [
        {
            "name": "{{ meta.author }}",
            "url": "{{ meta.url }}",
            "avatar": "{{ meta.indieweb.avatar }}"
        }
    ],
    "items" : [
    {%- for post in collections[collectionName] %}
    {%- set filteredTags = post.data.tags | filterTagsFromFeeds %}
    {
        "id" : {{ post.url | default("", true) | dump | safe }},
        "title": {{ post.data.title | default("", true) | dump | safe }},
        "url": {{ post.url | stripIndex | absoluteUrl(meta.url) | default("", true) | dump | safe }},
        "content_html": {{ post.templateContent | dump | safe }},
        "summary": {{ post.data.excerpt | default("", true) | dump | safe }},
        "image": {% if post.data.image %}{{ post.data.image | url | default("", true) | dump | safe }}{% else %}""{% endif %},
        {% if post.data.layout === 'bookmark' %}
        "external_url": {{ post.data.bookmarkOf | url | default("", true) | dump | safe }},
        {% endif %}
        "_posse": {
            "masto_text": {{ { "externalLink": post.data.layout === 'bookmark', "layout": post.data.layout, "type": post.data.type, "title": post.data.title, "author": post.data.author, "bookmark": post.data.bookmarkOf, "content": post.templateContent, "permalink": post.url | stripIndex } | makeTootText | dump | safe }},

            "bsky_text": {{ { "externalLink": post.data.layout === 'bookmark', "layout": post.data.layout, "type": post.data.type, "title": post.data.title, "author": post.data.author, "bookmark": post.data.bookmarkOf, "content": post.templateContent, "permalink": post.url | stripIndex } | makeBlueskyText | dump | safe }},

            "tags": {% if filteredTags %}{{ filteredTags | dump | safe }}{% else %}[]{% endif %},
            "opengraph": {{ post.data | socialImageUrl | default("", true) | dump | safe }}
        },
        "date_published": {{ post.date | dateForFeed | default("", true) | dump | safe }},
        "tags": {% if filteredTags %}{{ filteredTags | dump | safe }}{% else %}[]{% endif %}
    }{% if not loop.last %},{% else %}{%- endif -%}
    {%- endfor -%}
]}
