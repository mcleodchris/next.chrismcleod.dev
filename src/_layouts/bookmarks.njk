---
layout: base
---

<header class="section">
    <div class="wrapper flow">
      <section class="prose text-center">
        <h1 class="fade-in">{{ title }}</h1>
      </section>
    </div>
</header>
<article class="region">
  <div class="wrapper flow prose">  {{ content | safe }}</div>
   <div class="wrapper flow prose">  
    <p class="text-center">
      <a href="/follow/bookmarks/feed.atom" class="button">
      {% include 'icons/social-rss.svg' %}
        Atom
      </a>
      <a href="/follow/bookmarks/feed.rss" class="button">
      {% include 'icons/social-rss.svg' %}
        RSS
      </a>
      <a href="/follow/bookmarks/feed.json" class="button">
      {% include 'icons/social-rss.svg' %}
        JSON
      </a>
    </p>
   </div>
  <div class="wrapper flow prose mt-l-xl">
    <ul class="bookmarks | h-feed">
        {%- for item in pagination.items -%}

        <li class="h-entry">
            <a class="u-bookmark-of" href="{{ item.data | bookmarkUrl }}" rel="external">
                <span class="h-cite">{{item.data.title}}</span>
            </a>
            {% if item.content -%}
            <div class="e-content | flow prose">
              {{ item.content | safe }}
            </div>
            {% endif -%}
            {%- set definedDate = item.date -%}
            <div class="post-meta"><a href="{{item.url | url}}" class="u-url">{% include "partials/date.njk" -%}</a></div>
        </li>
        {% endfor -%}
    </ul>
  </div>
{% include "partials/pagination.njk" %}
</article>