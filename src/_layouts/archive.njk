---
layout: base
---

<header class="section spot-color-primary">
    <div class="wrapper flow">
      <section class="prose text-center">
        <h1 class="fade-in">{{ title }}</h1>
      </section>
    </div>
</header>
<article class="region">
  <div class="wrapper flow prose"> 
    {{ content | safe }}
    <sequoia-subscribe button-type="atmosphere"></sequoia-subscribe>

    <h2>Search</h2>
    <pagefind-search pagefind-autofocus>
      <form action="https://duckduckgo.com/" method="get" style="min-height: 3.2em;"><!-- min-height to reduce CLS -->
        <label>
          Search for:
          <input type="search" name="q" autocomplete="off" autofocus>
        </label>
        <!-- Put your searchable domain here -->
        <input type="hidden" name="sites" value="chrismcleod.dev">
        <button type="submit" class="button">Search</button>
      </form>
    </pagefind-search>
    <h2>Tags <small>({{collections.tagList.length}} unique tags)</small></h2>
    <p>Tags are used to label posts and group them together. Click on a tag to see all posts with that tag.</p>
    {% for tag in collections.tagList %}
      {% if loop.index <= 10 %}
        {% if collections[tag].length > 0 %}
        <a href="/tags/{{ tag }}" class="button">
        {{ tag }} 
        ({{ collections[tag].length }} post{% if collections[tag].length > 1 %}s{% endif %})
        </a>
        {% endif %}
      {% else %}
        {% if loop.index == 11 %}
        <details class="prose flow">
          <summary>More Tags</summary>
        {% endif %}
        {% if collections[tag].length > 0 %}
        <a href="/tags/{{ tag }}" class="button">
        {{ tag }} 
        ({{ collections[tag].length }} post{% if collections[tag].length > 1 %}s{% endif %})
        </a>
        {% endif %}
        {% if loop.index == collections.tagList.length %}
        </details>
        {% endif %}
      {% endif %}
    {% endfor %}
    <h2>Post Graphs</h2>
    {% postGraph collections.graph %}
  </div>

</article>