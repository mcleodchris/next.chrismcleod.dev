---
layout: base
---
<article class="region blog h-entry" data-pagefind-body>
  <div class="wrapper flow prose">
    <p>Liked <a class="u-like-of" href="{{ likeTarget }}" rel="external">{{ likeTarget }}</a></p>
    {% set definedDate = date %}
    <div class="post-meta"><a class="u-url" href="{{ page.url }}">🔗</a> {% include "partials/date.njk" %} by <a class="p-author h-card" href="{{ meta.authorWebsite }}">{{ meta.author }}</a></div>
    <div class="e-content flow prose">{{ content | safe }}</div>
  </div>
</article>
