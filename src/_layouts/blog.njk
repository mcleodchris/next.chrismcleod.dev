---
layout: base
---

<header class="section">
    <div class="wrapper flow region">
      <section class="prose text-center">
        <h1 class="fade-in">{{ title }}</h1>
      </section>
    </div>
</header>
<article class="region">
  <div class="wrapper flow prose">  {{ content | safe }}</div>


  <ul class="wrapper flow prose mt-l-xl h-feed" role="list">
    {%- for item in pagination.items %}

    <li class="h-entry">
      <h2>
        <a href="{{ item.url }}">{{ item.data.title }}</a>
      </h2>
      {% set definedDate = item.date %} {% include "partials/date.njk" %}
      <p>{{ item.data.description }}</p>
    </li>

    {% endfor %}
  </ul>
{% include "partials/pagination.njk" %}
</article>