---
layout: base
---

<header class="section">
    <div class="wrapper flow region">
      <h1 class="text-center">{{ title }}</h1>
    </div>
</header>
<article class="region page" style="--region-space-top: var(--space-m)">
  <div class="wrapper flow prose">
    {{ content | safe }}
  </div>
</article>
<article class="region" style="--region-space-top: var(--space-m)">
  <div class="wrapper flow prose">
    <h2>{{ blog.title }}</h2>
    <!-- blog intro text is optional. -->
    {% if blog.intro %}
      <p>{{ blog.intro }}</p>
    {% endif %}
  </div>
  <ul class="wrapper flow prose mt-l-xl h-feed" role="list" >
    {% set postslist = collections.posts %}
    {% for item in postslist.slice(0, 4) %}
      {% set headingLevel = 3 %}{% set itemClass = 'overflow-hidden' %}
      {% include "partials/post-list-item.njk" %}
    {% endfor %}
  </ul>
</article>