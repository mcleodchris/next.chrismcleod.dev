---
layout: base
permalink: "/bookmarks/{{ title | slugify }}/index.html"
---

<article class="region blog h-entry" data-pagefind-body>
  <div class="wrapper flow prose">
    <a class="u-bookmark-of" href="{{ bookmarkOf | url }}" rel="external">
        🔖 <span class="h-cite">{{title}}</span>
    </a>
    {% set definedDate = date %}
    <div class="post-meta"><a href="{{url | url}}" class="u-url">🔗</a> | {% include "partials/date.njk" -%}</div>
    {% if content -%}
    <div class="e-content | flow prose">
      {{ content | safe }}
    </div>
    {% endif -%}
  </div>
</article>